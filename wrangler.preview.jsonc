{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadora-infrastructure-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "b1173369c5dee97d46e465be28702897",
    "GOOGLE_OAUTH_CLIENT_ID": "818522168136-j4tqouj3mbacenfke42pju0id1dbr4qv.apps.googleusercontent.com",
    "GOOGLE_OAUTH_REDIRECT_URL": "https://leadrally.co.uk/api/gmail/callback",
    "GOOGLE_INTEGRATIONS_REDIRECT_URL": "https://leadrally.co.uk/api/google/callback"
  },
  "d1_databases": [
    {
      "binding": "LEADORA_DB",
      "database_name": "leadora-infrastructure-preview",
      "database_id": "455037f9-e5cd-4c54-a7e7-43fda9ad24ef"
    }
  ],
  "ai": { "binding": "AI" },
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "observability": { "enabled": true }
}
