{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadora",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GOOGLE_OAUTH_CLIENT_ID": "818522168136-j4tqouj3mbacenfke42pju0id1dbr4qv.apps.googleusercontent.com",
    "GOOGLE_OAUTH_REDIRECT_URL": "https://leadrally.co.uk/api/gmail/callback",
    "GOOGLE_INTEGRATIONS_REDIRECT_URL": "https://leadrally.co.uk/api/google/callback"
  },
  "routes": [
    {
      "pattern": "leadrally.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.leadrally.co.uk",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "LEADORA_DB",
      "database_name": "leadora-production",
      "database_id": "ab675c7e-e9e2-4253-9281-7db496792337"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
